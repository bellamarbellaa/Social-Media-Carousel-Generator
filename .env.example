# Copy this file to .env and fill in real values. Never commit .env.

# OpenAI-compatible gateway used for both copy generation and backdrop
# selection (see src/lib/gateway.ts). GATEWAY_MODEL is the exact model
# string your gateway expects (e.g. "gpt-4o-mini", "glm-5.1", etc).
GATEWAY_API_KEY=
GATEWAY_BASE_URL=
GATEWAY_MODEL=

# Pexels API key — from https://www.pexels.com/api/ (free tier).
# Used raw in the Authorization header, no "Bearer" prefix.
PEXELS_API_KEY=

# Notion internal integration token — from https://www.notion.so/my-integrations
# Must be shared with your carousel queue database (••• menu on the database
# page → Connections → add the integration).
NOTION_API_KEY=

# Your carousel queue database ID (from its Notion URL).
NOTION_DATABASE_ID=

# Optional. Set to "true" to write rendered PNGs to local-dry-run-output/
# instead of touching Notion — for iterating on slide layout locally.
DRY_RUN=false

# Only needed in the Trigger.dev dashboard (staging/prod), not locally —
# local dev uses Puppeteer's bundled Chromium.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
