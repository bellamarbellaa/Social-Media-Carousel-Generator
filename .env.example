# Copy this file to .env and fill in real values. Never commit .env.

# OpenAI-compatible gateway used for both copy generation and backdrop
# selection (see src/lib/gateway.ts). GATEWAY_MODEL is the exact model
# string your gateway expects (e.g. "gpt-4o-mini", "glm-5.1", etc).
GATEWAY_API_KEY=
GATEWAY_BASE_URL=
GATEWAY_MODEL=

# Pexels API key — from https://www.pexels.com/api/ (free tier).
# Used raw in the Authorization header, no "Bearer" prefix.
PEXELS_API_KEY=

# Notion internal integration token — from https://www.notion.so/my-integrations
# Must be shared with your carousel queue database (••• menu on the database
# page → Connections → add the integration).
NOTION_API_KEY=

# Your carousel queue database ID (from its Notion URL).
NOTION_DATABASE_ID=

# Optional. Set to "true" to write rendered PNGs to local-dry-run-output/
# instead of touching Notion — for iterating on slide layout locally.
DRY_RUN=false

# Only needed in the Trigger.dev dashboard (staging/prod), not locally —
# local dev uses Puppeteer's bundled Chromium.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# --- Instagram auto-publish (carousel-publish-to-instagram, carousel-refresh-ig-token) ---

# Supabase project URL and service role key — Project Settings > API in the
# Supabase dashboard. Used to upload rendered slides to a public Storage
# bucket, since the Instagram Graph API needs a public image_url per slide.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Name of a PUBLIC Supabase Storage bucket to upload slides into (create it
# in Storage > New bucket, toggle "Public bucket" on). e.g. "carousel-slides"
SUPABASE_STORAGE_BUCKET=

# Instagram professional account ID — GET https://graph.instagram.com/v21.0/me?fields=user_id
# using your access token (see README for the full setup flow).
IG_USER_ID=

# Bootstrap long-lived Instagram access token (~60 days). Only used once, to
# seed the "IG Token Store" Notion database — after that, the live token
# lives there and carousel-refresh-ig-token keeps it current. See README for
# how to get this.
IG_ACCESS_TOKEN=

# Instagram app secret (Meta app dashboard → your app → Instagram API use
# case → shown as "Instagram app secret"). Only needed for the one-time
# short-lived -> long-lived token exchange, not for ongoing refreshes.
IG_APP_SECRET=

# The "IG Token Store" Notion database ID (from its Notion URL). Must be
# shared with the same Notion integration as NOTION_API_KEY.
NOTION_IG_TOKEN_DB_ID=
